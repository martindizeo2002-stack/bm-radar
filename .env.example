ANTHROPIC_API_KEY=      # o correr `ant auth login` y dejarlo vacío
HUB_KEY=                # clave del hub (la misma que usa el equipo)
HUB_URL=https://bm-hub-ventas.netlify.app/.netlify/functions/panel
RADAR_MODEL=claude-opus-5
NETLIFY_SITE_ID=        # lo completa `run.py deploy` la primera vez
GROQ_API_KEY=
